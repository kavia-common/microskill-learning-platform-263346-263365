# Backend environment example
# PUBLIC_INTERFACE
# This file documents required variables for running the backend locally.

# Port for the backend server
PORT=3001

# The exact origin of the frontend for CORS (e.g., CRA default)
# For local CRA use:
# FRONTEND_ORIGIN=http://localhost:3000
# If you want to allow any origin (not recommended), set to *
FRONTEND_ORIGIN=http://localhost:3000

# Rate limiting (DiagnosticsPanel performs multiple probes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Optional Supabase configuration (if using persistence)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
