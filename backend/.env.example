# Backend environment variables (copy to .env and adjust)
PORT=3001

# Allow frontend origin for CORS (use http://localhost:3000 for CRA dev)
FRONTEND_ORIGIN=http://localhost:3000

# Optional Supabase (not required). If set, generate-lesson can persist results.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Node environment
NODE_ENV=development
