# Backend environment variables
# Copy this file to .env and adjust values as needed.

# Port for the Express server (default 3001)
PORT=3001

# Frontend origin for CORS (set to your frontend URL)
FRONTEND_ORIGIN=http://localhost:3000

# Optional Supabase configuration (only needed if persistence is desired)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# or use anon key if service role is unavailable
# SUPABASE_ANON_KEY=
