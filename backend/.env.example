# Backend Environment Example

# Network
PORT=3001
NODE_ENV=development

# CORS: Set to the frontend origin so browser requests are allowed.
# For Create React App default dev server:
FRONTEND_ORIGIN=http://localhost:3000

# Trust proxy (set true if behind reverse proxy)
TRUST_PROXY=false

# Logging level
LOG_LEVEL=info

# Rate limiting (defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Optional: Supabase settings (only if you enable persistence in generator)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
