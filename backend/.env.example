# Backend environment example
# PUBLIC_INTERFACE
PORT=3001

# CORS: set to the frontend origin to allow browser calls. Use * for permissive.
FRONTEND_ORIGIN=http://localhost:3000

# Optional: Supabase (only used if provided)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Log level
NODE_ENV=development
